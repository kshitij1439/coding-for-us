
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  credits        Int            @default(100) 
  projects       Project[]
  sessions       AgentSession[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Project {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  name           String
  description    String?
  
  // Tech Stack Metadata
  template       String?        // "react-vite", "nextjs", "node"
  
  files          File[]
  sessions       AgentSession[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model File {
  id             String         @id @default(cuid())
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String

  path           String         // "src/components/Button.jsx"
  content        String         @db.Text // Use Text type for large content
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([projectId, path]) // Prevent duplicate paths in one project
  @@index([projectId])
}

model AgentSession {
  id             String         @id @default(cuid())
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  user           User           @relation(fields: [userId], references: [id])
  userId         String

  messages       Message[]
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  @@index([projectId])
  @@index([userId])
}

model Message {
  id             String         @id @default(cuid())
  session        AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String

  role           String         // "user" | "assistant" | "system"
  content        String         @db.Text
  
  // AI Specifics
  tokens         Int?           // Total tokens for this turn
  latency        Int?           // ms took to generate
  
  createdAt      DateTime       @default(now())

  @@index([sessionId])
}